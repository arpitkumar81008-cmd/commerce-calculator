{
  "name": "commerce-calculator-backend",
  "version": "1.0.0",
  "description": "Backend API for the Commerce Calculator app",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:frontend": "node scripts/build-frontend.js",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
